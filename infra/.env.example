# --- Django/Backend ---
BACKEND_SECRET_KEY=change-me-to-a-random-secret-key
BACKEND_DEBUG=true
BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Database ---
POSTGRES_DB=sokol
POSTGRES_USER=sokol
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MinIO / S3 ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=sokol-media
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=change-me-minio-password
MINIO_USE_SSL=false

# --- VK ---
VK_APP_ID=
VK_APP_SECRET=
VK_SERVICE_TOKEN=

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
